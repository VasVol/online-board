[Unit]
Description=Pole math whiteboard
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Courses/online-board
ExecStart=/usr/bin/node dist-server/server/index.js
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOST=0.0.0.0
# For public HTTPS, add Environment=PUBLIC_ORIGIN=https://board.example.org
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
