{
  "name": "math-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web 'tsx watch server/index.ts' 'vite --host 0.0.0.0'",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:e2e && npm run test:e2e:production && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "backup": "tsx scripts/backup.ts",
    "bench": "tsx scripts/benchmark.ts",
    "predev": "node scripts/patch-excalidraw.mjs && node scripts/assets.mjs",
    "prebuild": "node scripts/patch-excalidraw.mjs && node scripts/assets.mjs",
    "format": "prettier --write src server shared tests scripts *.ts *.json *.md docs/*.md .github/workflows/*.yml",
    "postinstall": "node scripts/patch-excalidraw.mjs",
    "pretest:e2e": "node scripts/patch-excalidraw.mjs",
    "install:desktop": "python3 scripts/install-desktop.py",
    "test:e2e:production": "node scripts/patch-excalidraw.mjs && E2E_PRODUCTION=1 playwright test --grep \"pen width stays\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "better-sqlite3": "11.10.0",
    "express": "5.3.0",
    "lib0": "0.2.119",
    "lucide-react": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.22.0",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "katex": "0.18.2"
  }
}
